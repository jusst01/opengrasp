<mujoco model="opengrasp_restore_monolith">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.05 0.08 0.14 1"/>
    <global azimuth="125" elevation="-22"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.10 0.16 0.28" rgb2="0.01 0.02 0.05" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.13 0.16 0.22" rgb2="0.08 0.10 0.15" markrgb="0.5 0.6 0.7" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.15"/>
    <material name="stone" rgba="0.46 0.48 0.54 1" shininess="0.15" specular="0.3"/>
    <material name="darkstone" rgba="0.23 0.25 0.32 1" shininess="0.1" specular="0.2"/>
    <material name="gold" rgba="1.0 0.72 0.25 1" shininess="0.7" specular="0.9"/>
    <material name="goldsoft" rgba="0.85 0.58 0.20 1" shininess="0.5" specular="0.6"/>
    <material name="tealglow" rgba="0.10 0.95 0.82 1" shininess="0.9" specular="0.9"/>
    <material name="gem" rgba="0.15 0.85 0.95 1" shininess="0.95" specular="1"/>
    <material name="wood" rgba="0.42 0.28 0.16 1" shininess="0.2" specular="0.2"/>
    <material name="bannerred" rgba="0.55 0.13 0.22 1" shininess="0.1" specular="0.1"/>
    <material name="bannerteal" rgba="0.08 0.38 0.44 1" shininess="0.1" specular="0.1"/>
    <material name="flame" rgba="1.0 0.55 0.15 1" shininess="0.9" specular="0.5"/>
  </asset>

  <worldbody>
    <light pos="0.4 -0.6 1.6" dir="-0.3 0.4 -1" directional="true"/>
    <light pos="-0.6 0.5 1.2" dir="0.4 -0.3 -1"/>

    <!-- Ground and the great stone dais (top surface at z = 0.10) -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
    <geom name="dais" type="box" pos="-0.05 0 0.05" size="0.85 0.62 0.05" material="darkstone" friction="1.2 0.02 0.002"/>
    <geom name="dais_trim_front" type="box" pos="-0.05 0.615 0.085" size="0.85 0.012 0.015" material="goldsoft" contype="0" conaffinity="0"/>
    <geom name="dais_trim_back" type="box" pos="-0.05 -0.615 0.085" size="0.85 0.012 0.015" material="goldsoft" contype="0" conaffinity="0"/>

    <!-- Corner pillars, banners and torches (visual set dressing) -->
    <geom type="cylinder" pos="-0.80 0.55 0.36" size="0.055 0.26" material="stone" contype="0" conaffinity="0"/>
    <geom type="cylinder" pos="-0.80 -0.55 0.36" size="0.055 0.26" material="stone" contype="0" conaffinity="0"/>
    <geom type="cylinder" pos="0.72 0.55 0.36" size="0.055 0.26" material="stone" contype="0" conaffinity="0"/>
    <geom type="cylinder" pos="0.72 -0.55 0.36" size="0.055 0.26" material="stone" contype="0" conaffinity="0"/>
    <geom type="sphere" pos="-0.80 0.55 0.66" size="0.035" material="flame" contype="0" conaffinity="0"/>
    <geom type="sphere" pos="-0.80 -0.55 0.66" size="0.035" material="flame" contype="0" conaffinity="0"/>
    <geom type="sphere" pos="0.72 0.55 0.66" size="0.035" material="flame" contype="0" conaffinity="0"/>
    <geom type="sphere" pos="0.72 -0.55 0.66" size="0.035" material="flame" contype="0" conaffinity="0"/>
    <geom type="box" pos="-0.80 -0.50 0.44" size="0.012 0.055 0.14" material="bannerred" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.72 0.50 0.44" size="0.012 0.055 0.14" material="bannerteal" contype="0" conaffinity="0"/>

    <!-- Start plinth with a pocket: the drum stands here, nubs keep it from
         rolling during the approach (the pattern the relic pedestal proved). -->
    <geom name="plinth" type="cylinder" pos="-0.02 -0.30 0.15" size="0.095 0.05" material="stone" friction="1.0 0.02 0.002"/>
    <geom type="cylinder" pos="-0.02 -0.30 0.205" size="0.06 0.006" material="goldsoft" contype="0" conaffinity="0"/>
    <geom type="box" pos="-0.085 -0.30 0.215" size="0.006 0.028 0.012" material="stone" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.045 -0.30 0.215" size="0.006 0.028 0.012" material="stone" contype="0" conaffinity="0"/>
    <geom type="box" pos="-0.02 -0.365 0.215" size="0.028 0.006 0.012" material="stone" contype="0" conaffinity="0"/>
    <geom type="box" pos="-0.02 -0.235 0.215" size="0.028 0.006 0.012" material="stone" contype="0" conaffinity="0"/>

    <!-- The pillar socket: destination, raised and ringed -->
    <geom name="pillar" type="cylinder" pos="0.30 0.26 0.22" size="0.085 0.12" material="stone" friction="1.0 0.02 0.002" solref="0.004 1" solimp="0.9 0.99 0.001"/>
    <geom type="cylinder" pos="0.30 0.26 0.345" size="0.062 0.006" material="goldsoft" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.235 0.26 0.375" size="0.008 0.026 0.030" material="darkstone"/>
    <geom type="box" pos="0.365 0.26 0.375" size="0.008 0.026 0.030" material="darkstone"/>
    <geom type="box" pos="0.30 0.195 0.375" size="0.026 0.008 0.030" material="darkstone"/>
    <geom type="box" pos="0.30 0.325 0.375" size="0.026 0.008 0.030" material="darkstone"/>

    <!-- The Pillar Drum: heavy stone, graspable like the relic — the test is
         keeping it UPRIGHT and setting it true on the pillar. -->
    <body name="relic" pos="-0.02 -0.30 0.266">
      <joint name="relic_joint" type="free"/>
      <inertial mass="0.22" pos="0 0 0" diaginertia="0.0004 0.0004 0.0002"/>
      <geom name="relic_body" type="cylinder" size="0.030 0.055" material="stone" friction="1.15 0.03 0.003" solref="0.004 1" solimp="0.9 0.99 0.001"/>
      <geom type="cylinder" pos="0 0 0.040" size="0.031 0.007" material="goldsoft" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="0 0 -0.040" size="0.031 0.007" material="goldsoft" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 0.062" size="0.010" material="gem" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
